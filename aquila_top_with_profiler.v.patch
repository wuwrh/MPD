// =============================================================================
// Patch for aquila_top.v - Add Hardware Profiler
// 
// 用途：將 profiler.v 整合到 aquila_top.v 頂層模組
// 
// 使用方法：
//   1. 先執行 ./generate_profiler_table.sh 生成函式位址表
//   2. 開啟 aquila_top.v
//   3. 找到 RISCV_CORE0 實例化的位置（大約 line 289）
//   4. 在 RISCV_CORE0 實例化之後，加入以下代碼
//
// 注意：
//   - 需要確保 profiler_func_table.vh 已經生成
//   - 訊號名稱（如 p_i_addr, p_i_code）需對應實際 aquila_top.v 中的名稱
// =============================================================================

// ----------------------------------------------------------------------------
//  Hardware Profiler for CoreMark Analysis (HW1)
// ----------------------------------------------------------------------------

// Profiler output signals (visible to ILA)
wire [63:0] profiler_total_cycles;
wire [63:0] profiler_func0_cycles, profiler_func1_cycles, profiler_func2_cycles;
wire [63:0] profiler_func3_cycles, profiler_func4_cycles;
wire [63:0] profiler_func0_compute, profiler_func1_compute, profiler_func2_compute;
wire [63:0] profiler_func3_compute, profiler_func4_compute;
wire [63:0] profiler_func0_memory, profiler_func1_memory, profiler_func2_memory;
wire [63:0] profiler_func3_memory, profiler_func4_memory;
wire [63:0] profiler_global_compute, profiler_global_memory;
wire [4:0]  profiler_current_func;
wire        profiler_is_mem_cycle;

// Simple instruction decoder for Load/Store detection
// RISC-V opcode: Load = 7'b0000011, Store = 7'b0100011
wire [6:0] opcode = p_i_code[6:0];
wire is_load = (opcode == 7'b0000011);
wire is_store = (opcode == 7'b0100011);
wire is_load_store = is_load | is_store;

// Simple stall detection (instruction or data memory not ready)
wire pipeline_stall = ~p_i_ready | (~p_d_ready & p_d_strobe);

profiler #(
    .XLEN(XLEN),
    .NUM_FUNCTIONS(5)
) PROFILER (
    .clk_i(clk_i),
    .rst_i(rst_i),
    
    // Pipeline signals
    .pc_i(p_i_addr),
    .pc_valid_i(p_i_ready & p_i_strobe),
    .instr_i(p_i_code),
    .is_load_store_i(is_load_store & p_i_ready),
    .pipeline_stall_i(pipeline_stall),
    .mem_access_i(p_d_strobe),
    
    // Control
    .profiler_enable_i(1'b1),     // Always enabled
    .profiler_reset_i(1'b0),      // Never reset (use system reset)
    
    // Counter outputs (monitored by ILA)
    .total_cycles_o(profiler_total_cycles),
    
    .func0_cycles_o(profiler_func0_cycles),
    .func1_cycles_o(profiler_func1_cycles),
    .func2_cycles_o(profiler_func2_cycles),
    .func3_cycles_o(profiler_func3_cycles),
    .func4_cycles_o(profiler_func4_cycles),
    
    .func0_compute_cycles_o(profiler_func0_compute),
    .func1_compute_cycles_o(profiler_func1_compute),
    .func2_compute_cycles_o(profiler_func2_compute),
    .func3_compute_cycles_o(profiler_func3_compute),
    .func4_compute_cycles_o(profiler_func4_compute),
    
    .func0_memory_cycles_o(profiler_func0_memory),
    .func1_memory_cycles_o(profiler_func1_memory),
    .func2_memory_cycles_o(profiler_func2_memory),
    .func3_memory_cycles_o(profiler_func3_memory),
    .func4_memory_cycles_o(profiler_func4_memory),
    
    .global_compute_cycles_o(profiler_global_compute),
    .global_memory_cycles_o(profiler_global_memory),
    
    .current_function_o(profiler_current_func),
    .is_memory_cycle_o(profiler_is_mem_cycle)
);

// End of profiler integration
// ----------------------------------------------------------------------------


